{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grantscope",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The search page and PDFs (built by `npm run assets` into ./public). Matching paths are
  // served directly; everything else (/search, /ask, ...) reaches the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "hyperdrive": [
    // Hyperdrive config "grantscope-db" (pooled connection to Neon). Not a secret: the
    // credentials live in Cloudflare, this is only an ID.
    { "binding": "HYPERDRIVE", "id": "b9511581096f4b99a8cecdb0691def42" }
  ],
  "observability": { "enabled": true }
}
